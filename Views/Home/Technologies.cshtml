@{
    ViewData["Title"] = "Технологии";
}

<div class="container">
    <h1 class="mb-4">@ViewData["Title"]</h1>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h3>Frontend</h3>
                </div>
                <div class="card-body">
                    <ul>
                        <li>React.js</li>
                        <li>TypeScript</li>
                        <li>D3.js для визуализации</li>
                        <li>Bootstrap для UI</li>
                        <li>WebSocket для реального времени</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h3>Backend</h3>
                </div>
                <div class="card-body">
                    <ul>
                        <li>ASP.NET Core</li>
                        <li>Entity Framework</li>
                        <li>SQL Server</li>
                        <li>SignalR для real-time обновлений</li>
                        <li>Identity для аутентификации</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>