@model IEnumerable<NetworkTopologyVisitingCard.Models.ApplicationUser>

@{
    ViewData["Title"] = "Панель управления";
}

<h1>@ViewData["Title"]</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Имя пользователя</th>
            <th>Email</th>
            <th>Полное имя</th>
            <th>Дата регистрации</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@user.FullName</td>
                <td>@user.RegistrationDate.ToString("dd.MM.yyyy")</td>
                <td>
                    <a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-info btn-sm">Подробнее</a>
                </td>
            </tr>
        }
    </tbody>
</table>