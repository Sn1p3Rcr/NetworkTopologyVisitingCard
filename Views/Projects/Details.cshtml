@model NetworkTopologyVisitingCard.Models.Project

@{
    ViewData["Title"] = "Детали проекта";
}

<div class="container">
    <h1>@Model.Title</h1>
    
    <div class="row">
        <div class="col-md-8">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded mb-4" alt="@Model.Title">
            }
            
            <h3>Описание</h3>
            <p>@Model.Description</p>
            
            <h3>Используемые технологии</h3>
            <p>@Model.Technologies</p>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Информация о проекте</h5>
                    <p><strong>Автор:</strong> @Model.Author</p>
                    <p><strong>Дата создания:</strong> @Model.CreatedDate.ToShortDateString()</p>
                </div>
            </div>
            
            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редактировать</a>
                <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
            </div>
        </div>
    </div>
</div>