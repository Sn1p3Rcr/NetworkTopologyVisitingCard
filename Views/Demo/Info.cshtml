@{
    ViewData["Title"] = "Информация о механизмах хранения данных";
}

<style>
    .info-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 30px;
        border-radius: 10px;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .code-block {
        background: #2d3748;
        color: #a0aec0;
        padding: 20px;
        border-radius: 8px;
        font-family: 'Courier New', monospace;
        overflow-x: auto;
        margin: 15px 0;
        line-height: 1.6;
    }

    .pro-con {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin: 20px 0;
    }

    .pro-list, .con-list {
        padding: 15px;
        border-radius: 8px;
    }

    .pro-list {
        background: #c6f6d5;
        border-left: 4px solid #38a169;
        color: #22543d;
    }

    .con-list {
        background: #fed7d7;
        border-left: 4px solid #c53030;
        color: #742a2a;
    }

